@model BoutiqueTech.Models.Produit
@{
    ViewData["Title"] = "Modifier - " + Model.Nom;
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0"><i class="fas fa-edit"></i> Modifier le Produit</h4>
            </div>
            <div class="card-body">
                <form asp-action="Modifier" method="post">
                    <input asp-for="Id" type="hidden">
                    <input asp-for="DateAjout" type="hidden">

                    <div class="row">
                        <div class="col-md-8">
                            <div class="mb-3">
                                <label asp-for="Nom" class="form-label"></label>
                                <input asp-for="Nom" class="form-control">
                                <span asp-validation-for="Nom" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Description" class="form-label"></label>
                                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Marque" class="form-label"></label>
                                <input asp-for="Marque" class="form-control">
                                <span asp-validation-for="Marque" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="UrlImage" class="form-label"></label>
                                <input asp-for="UrlImage" class="form-control">
                                <span asp-validation-for="UrlImage" class="text-danger"></span>
                                <small class="form-text text-muted">URL de l'image du produit</small>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="Prix" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text">€</span>
                                    <input asp-for="Prix" class="form-control" step="0.01">
                                </div>
                                <span asp-validation-for="Prix" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Categorie" class="form-label"></label>
                                <select asp-for="Categorie" class="form-select">
                                    @foreach (var categorie in (IEnumerable<CategorieProduit>)ViewData["Categories"])
                                    {
                                        <option value="@categorie">
                                            @(categorie switch
                                            {
                                                CategorieProduit.Telephone => "Téléphone",
                                                CategorieProduit.OrdinateurPortable => "Ordinateur Portable",
                                                CategorieProduit.Tablette => "Tablette",
                                                CategorieProduit.Accessoire => "Accessoire",
                                                CategorieProduit.Gaming => "Gaming",
                                                _ => categorie.ToString()
                                            })
                                        </option>
                                    }
                                </select>
                                <span asp-validation-for="Categorie" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Statut" class="form-label"></label>
                                <select asp-for="Statut" class="form-select">
                                    @foreach (var statut in (IEnumerable<StatutProduit>)ViewData["Statuts"])
                                    {
                                        <option value="@statut">
                                            @(statut switch
                                            {
                                                StatutProduit.EnStock => "En Stock",
                                                StatutProduit.RuptureStock => "Rupture de Stock",
                                                StatutProduit.PreCommande => "Pré-commande",
                                                _ => statut.ToString()
                                            })
                                        </option>
                                    }
                                </select>
                                <span asp-validation-for="Statut" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Stock" class="form-label"></label>
                                <input asp-for="Stock" class="form-control" type="number" min="0">
                                <span asp-validation-for="Stock" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i>
                        <strong>Information :</strong> Ce produit a été ajouté le @Model.DateAjout.ToString("dd/MM/yyyy à HH:mm")
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" asp-route-vue="admin" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Annuler
                        </a>
                        <div>
                            <a asp-action="Details" asp-route-id="@Model.Id" asp-route-retour="admin" class="btn btn-info me-2">
                                <i class="fas fa-eye"></i> Voir détails
                            </a>
                            <button type="submit" class="btn btn-warning">
                                <i class="fas fa-save"></i> Enregistrer les modifications
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Aperçu des modifications -->
        <div class="card mt-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="fas fa-preview"></i> Aperçu du produit</h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        <img src="@Model.UrlImage" alt="@Model.Nom" class="img-fluid rounded"
                             style="max-height: 150px; object-fit: cover;"
                             onerror="this.src='/images/produit-defaut.jpg'">
                    </div>
                    <div class="col-md-8">
                        <h6>@Model.Nom</h6>
                        <p class="text-muted small">@Model.Description</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <affichage-prix prix="@Model.Prix"></affichage-prix>
                            <statut-produit statut="@Model.Statut"></statut-produit>
                        </div>
                        <div class="mt-2">
                            <small class="text-muted">
                                <i class="fas fa-tag"></i>
                                @(Model.Categorie switch
                                {
                                    CategorieProduit.Telephone => "Téléphone",
                                    CategorieProduit.OrdinateurPortable => "Ordinateur Portable",
                                    CategorieProduit.Tablette => "Tablette",
                                    CategorieProduit.Accessoire => "Accessoire",
                                    CategorieProduit.Gaming => "Gaming",
                                    _ => Model.Categorie.ToString()
                                })
                                | <i class="fas fa-warehouse"></i> Stock: @Model.Stock
                                @if (!string.IsNullOrEmpty(Model.Marque))
                                {
                                    <text> | <i class="fas fa-industry"></i> @Model.Marque</text>
                                }
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}