@model BoutiqueTech.Models.Produit
@{
    ViewData["Title"] = "Supprimer - " + Model.Nom;
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0"><i class="fas fa-exclamation-triangle"></i> Confirmation de Suppression</h4>
            </div>
            <div class="card-body text-center">
                <div class="mb-4">
                    <img src="@Model.UrlImage" alt="@Model.Nom" class="img-thumbnail" style="max-width: 200px; max-height: 200px; object-fit: cover;"
                         onerror="this.src='/images/produit-defaut.jpg'">
                </div>

                <h5 class="card-title">@Model.Nom</h5>
                <p class="text-muted">@Model.Description</p>

                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle"></i>
                    <strong>Attention :</strong> Cette action est irréversible.
                    Êtes-vous sûr de vouloir supprimer définitivement ce produit ?
                </div>

                <div class="product-info bg-light p-3 rounded mb-4">
                    <div class="row text-start">
                        <div class="col-6">
                            <strong><i class="fas fa-euro-sign"></i> Prix :</strong>
                            <affichage-prix prix="@Model.Prix"></affichage-prix>
                        </div>
                        <div class="col-6">
                            <strong><i class="fas fa-tag"></i> Catégorie :</strong>
                            @(Model.Categorie switch
                            {
                                CategorieProduit.Telephone => "Téléphone",
                                CategorieProduit.OrdinateurPortable => "Ordinateur Portable",
                                CategorieProduit.Tablette => "Tablette",
                                CategorieProduit.Accessoire => "Accessoire",
                                CategorieProduit.Gaming => "Gaming",
                                _ => Model.Categorie.ToString()
                            })
                        </div>
                        <div class="col-6 mt-2">
                            <strong><i class="fas fa-warehouse"></i> Stock :</strong>
                            <indicateur-stock stock="@Model.Stock"></indicateur-stock>
                        </div>
                        <div class="col-6 mt-2">
                            <strong><i class="fas fa-info-circle"></i> Statut :</strong>
                            <statut-produit statut="@Model.Statut"></statut-produit>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Marque))
                        {
                            <div class="col-6 mt-2">
                                <strong><i class="fas fa-industry"></i> Marque :</strong> @Model.Marque
                            </div>
                        }
                        <div class="col-6 mt-2">
                            <strong><i class="fas fa-calendar-alt"></i> Ajouté le :</strong>
                            @Model.DateAjout.ToString("dd/MM/yyyy")
                        </div>
                    </div>
                </div>

                <div class="alert alert-danger">
                    <i class="fas fa-trash"></i>
                    <strong>Conséquences de la suppression :</strong>
                    <ul class="list-unstyled mt-2 mb-0">
                        <li>• Le produit sera retiré définitivement du catalogue</li>
                        <li>• Toutes les informations seront perdues</li>
                        <li>• Cette action ne peut pas être annulée</li>
                    </ul>
                </div>

                <form asp-action="Supprimer" method="post" class="d-inline">
                    <div class="d-flex flex-column gap-2">
                        <div class="d-flex justify-content-center gap-2">
                            <a asp-action="Index" asp-route-vue="admin" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Annuler
                            </a>
                            <a asp-action="Details" asp-route-id="@Model.Id" asp-route-retour="admin" class="btn btn-info">
                                <i class="fas fa-eye"></i> Voir détails
                            </a>
                        </div>
                        <button type="submit" class="btn btn-danger btn-lg"
                                onclick="return confirm('Êtes-vous absolument certain de vouloir supprimer le produit &quot;@Model.Nom&quot; ? Cette action est irréversible.')">
                            <i class="fas fa-trash"></i> Confirmer la suppression définitive
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Informations supplémentaires -->
        <div class="card mt-3">
            <div class="card-body">
                <h6><i class="fas fa-lightbulb"></i> Alternatives à la suppression :</h6>
                <ul class="list-unstyled">
                    <li>
                        <i class="fas fa-edit text-warning"></i>
                        <a asp-action="Modifier" asp-route-id="@Model.Id" class="text-decoration-none">
                            Modifier ce produit
                        </a> si vous voulez changer ses informations
                    </li>
                    <li class="mt-2">
                        <i class="fas fa-eye-slash text-secondary"></i>
                        Changer le statut en "Rupture de Stock" pour le masquer temporairement
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>