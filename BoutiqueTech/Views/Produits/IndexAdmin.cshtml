@model IEnumerable<BoutiqueTech.Models.Produit>
@{
    ViewData["Title"] = "Administration - Gestion des Produits";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-cogs"></i> Administration des Produits</h2>
    <a asp-action="Creer" class="btn btn-success btn-lg">
        <i class="fas fa-plus"></i> Nouveau Produit
    </a>
</div>

<div class="alert alert-info">
    <i class="fas fa-info-circle"></i>
    <strong>Mode Administrateur :</strong> Gérez l'ensemble de vos produits depuis cette interface.
</div>

<!-- Barre de recherche et filtres -->
<div class="card mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3">
            <input type="hidden" name="vue" value="admin" />
            <div class="col-md-6">
                <label for="chaineRecherche" class="form-label">
                    <i class="fas fa-search"></i> Rechercher
                </label>
                <input type="text" class="form-control" id="chaineRecherche" name="chaineRecherche" 
                       value="@ViewData["FiltreActuel"]" placeholder="Nom, description, marque...">
            </div>
            <div class="col-md-4">
                <label for="categorie" class="form-label">
                    <i class="fas fa-filter"></i> Catégorie
                </label>
                <select class="form-select" id="categorie" name="categorie">
                    <option value="">Toutes les catégories</option>
                    @foreach (var cat in (IEnumerable<CategorieProduit>)ViewData["Categories"])
                    {
                        <option value="@cat" selected="@(ViewData["CategorieActuelle"]?.Equals(cat) == true)">
                            @(cat switch
                            {
                                CategorieProduit.Telephone => "Téléphone",
                                CategorieProduit.OrdinateurPortable => "Ordinateur Portable",
                                CategorieProduit.Tablette => "Tablette",
                                CategorieProduit.Accessoire => "Accessoire",
                                CategorieProduit.Gaming => "Gaming",
                                _ => cat.ToString()
                            })
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search"></i> Rechercher
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Statistiques rapides -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-center bg-primary text-white">
            <div class="card-body">
                <h5>@Model.Count()</h5>
                <p class="mb-0">Total Produits</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center bg-success text-white">
            <div class="card-body">
                <h5>@Model.Count(p => p.Statut == StatutProduit.EnStock)</h5>
                <p class="mb-0">En Stock</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center bg-danger text-white">
            <div class="card-body">
                <h5>@Model.Count(p => p.Statut == StatutProduit.RuptureStock)</h5>
                <p class="mb-0">Rupture Stock</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center bg-warning text-dark">
            <div class="card-body">
                <h5>@Model.Count(p => p.Statut == StatutProduit.PreCommande)</h5>
                <p class="mb-0">Pré-commande</p>
            </div>
        </div>
    </div>
</div>

<!-- Tableau des produits -->
@if (Model.Any())
{
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="fas fa-table"></i> Liste des Produits
                <span class="badge bg-secondary ms-2">@Model.Count() produit(s)</span>
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col">ID</th>
                            <th scope="col">Image</th>
                            <th scope="col">Nom</th>
                            <th scope="col">Catégorie</th>
                            <th scope="col">Marque</th>
                            <th scope="col">Prix</th>
                            <th scope="col">Stock</th>
                            <th scope="col">Statut</th>
                            <th scope="col">Date d'ajout</th>
                            <th scope="col" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var produit in Model)
                        {
                            <tr>
                                <td class="fw-bold">@produit.Id</td>
                                <td>
                                    <img src="@produit.UrlImage" alt="@produit.Nom" 
                                         class="img-thumbnail" style="width: 50px; height: 50px; object-fit: cover;"
                                         onerror="this.src='/images/produit-defaut.jpg'">
                                </td>
                                <td>
                                    <div class="fw-bold">@produit.Nom</div>
                                    <small class="text-muted">@(produit.Description.Length > 50 ? produit.Description.Substring(0, 50) + "..." : produit.Description)</small>
                                </td>
                                <td>
                                    <span class="badge bg-info">
                                        @(produit.Categorie switch
                                        {
                                            CategorieProduit.Telephone => "Téléphone",
                                            CategorieProduit.OrdinateurPortable => "Ordinateur",
                                            CategorieProduit.Tablette => "Tablette",
                                            CategorieProduit.Accessoire => "Accessoire",
                                            CategorieProduit.Gaming => "Gaming",
                                            _ => produit.Categorie.ToString()
                                        })
                                    </span>
                                </td>
                                <td>@produit.Marque</td>
                                <td class="fw-bold text-success">@produit.Prix.ToString("C")</td>
                                <td>
                                    @if (produit.Stock > 10)
                                    {
                                        <span class="badge bg-success">@produit.Stock</span>
                                    }
                                    else if (produit.Stock > 0)
                                    {
                                        <span class="badge bg-warning text-dark">@produit.Stock</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">@produit.Stock</span>
                                    }
                                </td>
                                <td>
                                    @switch (produit.Statut)
                                    {
                                        case StatutProduit.EnStock:
                                            <span class="badge bg-success">En Stock</span>
                                            break;
                                        case StatutProduit.RuptureStock:
                                            <span class="badge bg-danger">Rupture</span>
                                            break;
                                        case StatutProduit.PreCommande:
                                            <span class="badge bg-warning text-dark">Pré-commande</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <small>@produit.DateAjout.ToString("dd/MM/yyyy")</small>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Details" asp-route-id="@produit.Id" asp-route-retour="admin" 
                                           class="btn btn-outline-info" title="Voir les détails">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Modifier" asp-route-id="@produit.Id" 
                                           class="btn btn-outline-warning" title="Modifier">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Supprimer" asp-route-id="@produit.Id" 
                                           class="btn btn-outline-danger" title="Supprimer"
                                           onclick="return confirm('Êtes-vous sûr de vouloir supprimer le produit @produit.Nom ?')">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Actions en bas -->
    <div class="d-flex justify-content-between align-items-center mt-4">
        <div>
            <a asp-controller="Accueil" asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-home"></i> Retour à l'accueil
            </a>
            <a asp-controller="Produits" asp-action="Index" asp-route-vue="catalogue" class="btn btn-outline-primary">
                <i class="fas fa-eye"></i> Voir le catalogue public
            </a>
        </div>
        <div>
            <a asp-action="Creer" class="btn btn-success">
                <i class="fas fa-plus"></i> Ajouter un produit
            </a>
        </div>
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="fas fa-box-open fa-4x text-muted mb-3"></i>
        <h4 class="text-muted">Aucun produit trouvé</h4>
        <p class="text-muted">Commencez par ajouter des produits à votre catalogue.</p>
        <div class="d-flex justify-content-center gap-2">
            <a asp-action="Index" asp-route-vue="admin" class="btn btn-outline-primary">
                <i class="fas fa-refresh"></i> Réinitialiser les filtres
            </a>
            <a asp-action="Creer" class="btn btn-success btn-lg">
                <i class="fas fa-plus"></i> Ajouter le premier produit
            </a>
        </div>
    </div>
}

<!-- Actions rapides pour l'administration -->
<div class="card mt-4">
    <div class="card-header">
        <h6 class="mb-0"><i class="fas fa-bolt"></i> Actions Rapides</h6>
    </div>
    <div class="card-body">
        <div class="row text-center">
            <div class="col-md-3">
                <a asp-action="Creer" class="btn btn-outline-success btn-lg w-100 mb-2">
                    <i class="fas fa-plus-circle d-block mb-1"></i>
                    Créer
                </a>
                <small class="text-muted">Ajouter un nouveau produit</small>
            </div>
            <div class="col-md-3">
                <a href="#" onclick="window.location.reload()" class="btn btn-outline-primary btn-lg w-100 mb-2">
                    <i class="fas fa-sync-alt d-block mb-1"></i>
                    Actualiser
                </a>
                <small class="text-muted">Rafraîchir la liste</small>
            </div>
            <div class="col-md-3">
                <a asp-controller="Produits" asp-action="Index" asp-route-vue="catalogue" class="btn btn-outline-info btn-lg w-100 mb-2">
                    <i class="fas fa-store d-block mb-1"></i>
                    Catalogue
                </a>
                <small class="text-muted">Vue client</small>
            </div>
            <div class="col-md-3">
                <button type="button" class="btn btn-outline-secondary btn-lg w-100 mb-2" onclick="exportData()">
                    <i class="fas fa-download d-block mb-1"></i>
                    Exporter
                </button>
                <small class="text-muted">Exporter la liste</small>
            </div>
        </div>
    </div>
</div>

<script>
function exportData() {
    // Fonction simple d'export (à développer selon vos besoins)
    alert('Fonctionnalité d\'export en cours de développement');
}

// Confirmation de suppression avec plus de détails
function confirmerSuppression(nom, id) {
    return confirm(`Êtes-vous absolument certain de vouloir supprimer le produit "${nom}" ?\n\nCette action est irréversible.`);
}
</script>