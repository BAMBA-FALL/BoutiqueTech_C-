@{
    ViewData["Title"] = "Finaliser ma commande";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h3 class="mb-0">
                        <i class="fas fa-credit-card me-2"></i>Finaliser ma commande
                    </h3>
                </div>
                <div class="card-body">
                    <form id="commande-form" novalidate>
                        <!-- Informations personnelles -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h5 class="mb-3"><i class="fas fa-user me-2"></i>Informations personnelles</h5>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input type="text" class="form-control" id="prenom" name="Prenom" placeholder="Prénom" required value="Khadim">
                                    <label for="prenom">Prénom *</label>
                                    <div class="invalid-feedback">Veuillez saisir votre prénom</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input type="text" class="form-control" id="nom" name="Nom" placeholder="Nom" required value="Fall">
                                    <label for="nom">Nom *</label>
                                    <div class="invalid-feedback">Veuillez saisir votre nom</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input type="email" class="form-control" id="email" name="Email" placeholder="Email" required value="khadim.fall@example.com">
                                    <label for="email">Email *</label>
                                    <div class="invalid-feedback">Veuillez saisir un email valide</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input type="tel" class="form-control" id="telephone" name="Telephone" placeholder="Téléphone" required value="+33000000000">
                                    <label for="telephone">Téléphone *</label>
                                    <div class="invalid-feedback">Veuillez saisir votre numéro de téléphone</div>
                                </div>
                            </div>
                        </div>

                        <!-- Adresse de livraison -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h5 class="mb-3"><i class="fas fa-home me-2"></i>Adresse de livraison</h5>
                            </div>
                            <div class="col-12">
                                <div class="form-floating mb-3">
                                    <input type="text" class="form-control" id="adresse" name="Adresse" placeholder="Adresse" required value="1 rue Paris">
                                    <label for="adresse">Adresse complète *</label>
                                    <div class="invalid-feedback">Veuillez saisir votre adresse</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-floating mb-3">
                                    <input type="text" class="form-control" id="codePostal" name="CodePostal" placeholder="Code postal" pattern="[0-9]{5}" required value="75000">
                                    <label for="codePostal">Code postal *</label>
                                    <div class="invalid-feedback">Code postal invalide (5 chiffres)</div>
                                </div>
                            </div>
                            <div class="col-md-8">
                                <div class="form-floating mb-3">
                                    <input type="text" class="form-control" id="ville" name="Ville" placeholder="Ville" required value="Paris">
                                    <label for="ville">Ville *</label>
                                    <div class="invalid-feedback">Veuillez saisir votre ville</div>
                                </div>
                            </div>
                        </div>

                        <!-- Informations de paiement -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h5 class="mb-3"><i class="fas fa-credit-card me-2"></i>Informations de paiement</h5>
                            </div>
                            <div class="col-12">
                                <div class="form-floating mb-3">
                                    <input type="text" class="form-control" id="numeroCarte" placeholder="Numéro de carte"
                                           pattern="[0-9\s]{13,19}" maxlength="19" required value="4111 1111 1111 1111">
                                    <label for="numeroCarte">Numéro de carte *</label>
                                    <div class="invalid-feedback">Numéro de carte invalide</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input type="text" class="form-control" id="dateExpiration" placeholder="MM/AA"
                                           pattern="(0[1-9]|1[0-2])\/([0-9]{2})" maxlength="5" required value="12/25">
                                    <label for="dateExpiration">Date d'expiration (MM/AA) *</label>
                                    <div class="invalid-feedback">Format invalide (MM/AA)</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input type="text" class="form-control" id="cvv" placeholder="CVV"
                                           pattern="[0-9]{3,4}" maxlength="4" required value="123">
                                    <label for="cvv">CVV *</label>
                                    <div class="invalid-feedback">CVV invalide (3-4 chiffres)</div>
                                </div>
                            </div>
                        </div>

                        <!-- Conditions générales -->
                        <div class="form-check mb-4">
                            <input class="form-check-input" type="checkbox" id="conditions" required checked>
                            <label class="form-check-label" for="conditions">
                                J'accepte les <a href="#" data-bs-toggle="modal" data-bs-target="#conditionsModal">conditions générales de vente</a> *
                            </label>
                            <div class="invalid-feedback">Vous devez accepter les conditions générales</div>
                        </div>

                        <!-- Boutons d'action -->
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a href="https://localhost:7096/" class="btn btn-outline-secondary me-md-2">
                                <i class="fas fa-arrow-left me-2"></i>Retour au panier
                            </a>
                            <button type="submit" class="btn btn-success" id="btn-valider-commande">
                                <i class="fas fa-lock me-2"></i>Valider ma commande
                                <span class="spinner-border spinner-border-sm ms-2 d-none" id="loading-spinner"></span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Résumé de commande -->
        <div class="col-md-4">
            <div class="card sticky-top">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-receipt me-2"></i>Résumé de votre commande</h5>
                </div>
                <div class="card-body">
                    <div id="resume-panier">
                        <div class="text-center text-muted" id="chargement-resume">
                            <i class="fas fa-spinner fa-spin me-2"></i>Chargement...
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal succès -->
<div class="modal fade" id="successModal" tabindex="-1" aria-labelledby="successModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-center py-5">
            <div class="mb-4"><i class="fas fa-check-circle text-success" style="font-size: 4rem;"></i></div>
            <h4 class="text-success mb-3">Commande validée avec succès !</h4>
            <p class="mb-3">Votre commande a été enregistrée.</p>
            <p class="fw-bold mb-4">Numéro de commande : <span id="numero-commande" class="text-primary"></span></p>
            <p class="text-muted small mb-4">Vous recevrez un email de confirmation sous peu.</p>
            <button type="button" class="btn btn-primary" id="btn-retour-accueil">
                <i class="fas fa-home me-2"></i>Retour à l'accueil
            </button>
        </div>
    </div>
</div>

<!-- Modal conditions générales -->
<div class="modal fade" id="conditionsModal" tabindex="-1" aria-labelledby="conditionsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="conditionsModalLabel">Conditions générales de vente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                <h6>Article 1 - Objet</h6>
                <p>Les présentes conditions générales de vente régissent les relations contractuelles entre BoutiqueTech et ses clients.</p>
                <h6>Article 2 - Commandes</h6>
                <p>Toute commande implique l'acceptation pleine et entière des présentes conditions générales.</p>
                <h6>Article 3 - Livraison</h6>
                <p>Les délais de livraison sont donnés à titre indicatif. Un retard de livraison ne peut donner lieu à annulation de la commande ou indemnisation.</p>
                <h6>Article 4 - Paiement</h6>
                <p>Le paiement s'effectue au moment de la commande par carte bancaire sécurisée.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        class GestionnaireCommande {
            constructor() {
                this.form = document.getElementById('commande-form');
                this.panier = this.chargerPanier();
                this.afficherResumeCommande();
                this.initialiserEvenements();

                // Optionnel : préremplir automatiquement le numéro de carte
                document.getElementById('numeroCarte').value = '4111 1111 1111 1111';
            }

            chargerPanier() {
                const panierData = localStorage.getItem('panier');
                return panierData ? JSON.parse(panierData) : [];
            }

            afficherResumeCommande() {
                const resumeContainer = document.getElementById('resume-panier');
                const chargementResume = document.getElementById('chargement-resume');
                if (this.panier.length === 0) {
                    chargementResume.innerHTML = '<i class="fas fa-exclamation-triangle text-warning me-2"></i>Aucun produit dans le panier';
                    return;
                }
                chargementResume.style.display = 'none';
                let html = '';
                let sousTotal = 0;
                this.panier.forEach(item => {
                    const totalItem = item.prix * item.quantite;
                    sousTotal += totalItem;
                    html += `<div class="d-flex justify-content-between align-items-center mb-2">
                                <div>${item.nom} x ${item.quantite}</div>
                                <div>${totalItem.toFixed(2)} €</div>
                             </div>`;
                });
                const fraisLivraison = sousTotal >= 50 ? 0 : 5.99;
                const total = sousTotal + fraisLivraison;
                html += `<hr>
                        <div class="d-flex justify-content-between">
                            <span>Sous-total :</span><span>${sousTotal.toFixed(2)} €</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Livraison :</span><span>${fraisLivraison === 0 ? 'Gratuite' : fraisLivraison.toFixed(2) + ' €'}</span>
                        </div>
                        <div class="d-flex justify-content-between fw-bold">
                            <span>Total :</span><span>${total.toFixed(2)} €</span>
                        </div>`;
                resumeContainer.innerHTML = html;
            }

            initialiserEvenements() {
                this.form.addEventListener('submit', (e) => {
                    e.preventDefault();
                    this.validerCommande();
                });

                document.getElementById('btn-retour-accueil').addEventListener('click', ()=>{
                    localStorage.removeItem('panier');
                    localStorage.removeItem('panierCount');
                    window.location.href = 'https://localhost:7096/';
                });
            }

            async validerCommande() {
                if (this.panier.length === 0) {
                    alert('Votre panier est vide');
                    return;
                }

                // Simulation API
                const numeroCommande = `CMD-${Date.now()}`;
                document.getElementById('numero-commande').textContent = numeroCommande;
                const successModal = new bootstrap.Modal(document.getElementById('successModal'));
                successModal.show();

                // Vider le panier
                localStorage.removeItem('panier');
                localStorage.removeItem('panierCount');
                this.panier = [];
                this.afficherResumeCommande();
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            new GestionnaireCommande();
        });
    </script>
}

<style>
    .sticky-top {
        top: 20px;
    }

    .resume-items {
        max-height: 300px;
        overflow-y: auto;
    }
</style>
