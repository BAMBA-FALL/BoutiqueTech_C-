@model BoutiqueTech.Controllers.ModeleErreur
@{
    ViewData["Title"] = "Erreur";
}

<div class="text-center">
    <h1 class="display-1 text-danger"><i class="fas fa-exclamation-triangle"></i></h1>
    <h2 class="display-4">Oops! Une erreur s'est produite</h2>
    <p class="lead">Nous sommes désolés, mais quelque chose s'est mal passé.</p>

    @if (Model.AfficherIdRequete)
    {
        <div class="alert alert-info">
            <strong>ID de la requête:</strong> <code>@Model.IdRequete</code>
        </div>
    }

    <div class="mt-4">
        <a asp-controller="Accueil" asp-action="Index" class="btn btn-primary">
            <i class="fas fa-home"></i> Retour à l'accueil
        </a>
        <a asp-controller="Produits" asp-action="Index" class="btn btn-outline-primary">
            <i class="fas fa-store"></i> Voir les produits
        </a>
    </div>

    <div class="mt-5">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="fas fa-info-circle"></i> Que faire maintenant ?
                </h5>
                <div class="row text-start">
                    <div class="col-md-6">
                        <h6>Actions possibles :</h6>
                        <ul>
                            <li>Retourner à la page d'accueil</li>
                            <li>Consulter le catalogue des produits</li>
                            <li>Rafraîchir la page (F5)</li>
                            <li>Vérifier votre connexion internet</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h6>Informations techniques :</h6>
                        <p class="text-muted small">
                            Si cette erreur persiste, il peut s'agir d'un problème temporaire.
                            Cette application est en cours de développement dans le cadre d'un projet académique.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>