@{
    ViewData["Title"] = "Mon Panier";
}

@{
    ViewData["Title"] = "Mon Panier";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="mb-0">
                        <i class="fas fa-shopping-cart me-2"></i>Mon Panier
                    </h3>
                    <span class="badge bg-primary" id="compteur-panier">0</span>
                </div>
                <div class="card-body">
                    <div id="contenu-panier">
                        <div class="text-center py-5" id="panier-vide">
                            <i class="fas fa-shopping-cart fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">Votre panier est vide</h5>
                            <p class="text-muted">Ajoutez des produits pour commencer vos achats</p>
                            <a href="@Url.Action("Index", "Produits")" class="btn btn-primary">
                                <i class="fas fa-arrow-left me-2"></i>Continuer mes achats
                            </a>
                        </div>
                        
                        <div id="liste-produits" style="display: none;">
                            <!-- Les produits seront ajoutés ici par JavaScript -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card" id="resume-commande" style="display: none;">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-calculator me-2"></i>Résumé de la commande
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Sous-total :</span>
                        <span id="sous-total">0,00 €</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Livraison :</span>
                        <span id="frais-livraison">Gratuite</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between mb-3">
                        <strong>Total :</strong>
                        <strong id="total">0,00 €</strong>
                    </div>
                    <button class="btn btn-success w-100 mb-2" id="btn-commander">
                        <i class="fas fa-credit-card me-2"></i>Commander
                    </button>
                    <button class="btn btn-outline-danger w-100" id="btn-vider-panier">
                        <i class="fas fa-trash me-2"></i>Vider le panier
                    </button>
                </div>
            </div>
            
            <div class="card mt-3">
                <div class="card-body">
                    <h6><i class="fas fa-truck me-2"></i>Livraison gratuite</h6>
                    <p class="text-muted small mb-0">Pour toute commande supérieure à 50€</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Template pour un produit dans le panier -->
<template id="template-produit-panier">
    <div class="card mb-3 produit-panier">
        <div class="row g-0">
            <div class="col-md-3">
                <img src="" class="img-fluid rounded-start produit-image" alt="Image produit" style="height: 150px; object-fit: cover;">
            </div>
            <div class="col-md-6">
                <div class="card-body">
                    <h6 class="card-title produit-nom"></h6>
                    <p class="card-text">
                        <small class="text-muted produit-marque"></small>
                    </p>
                    <p class="card-text produit-description text-truncate"></p>
                    <p class="text-primary fw-bold produit-prix"></p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card-body d-flex flex-column justify-content-between h-100">
                    <div class="input-group mb-2">
                        <button class="btn btn-outline-secondary btn-sm btn-diminuer" type="button">
                            <i class="fas fa-minus"></i>
                        </button>
                        <input type="number" class="form-control text-center quantite-input" value="1" min="1" max="99">
                        <button class="btn btn-outline-secondary btn-sm btn-augmenter" type="button">
                            <i class="fas fa-plus"></i>
                        </button>
                    </div>
                    <button class="btn btn-outline-danger btn-sm btn-supprimer w-100" type="button">
                        <i class="fas fa-trash"></i> Supprimer
                    </button>
                </div>
            </div>
        </div>
    </div>
</template>

@section Scripts {
    <script>
        // Gestion du panier avec localStorage
        class GestionnairedePanier {
            constructor() {
                this.chargerPanier();
                this.afficherPanier();
                this.initialiserEvenements();
            }

            chargerPanier() {
                const panierData = localStorage.getItem('panier');
                this.panier = panierData ? JSON.parse(panierData) : [];
            }

            sauvegarderPanier() {
                localStorage.setItem('panier', JSON.stringify(this.panier));
                this.mettreAJourCompteur();
            }

            ajouterProduit(produit) {
                const existant = this.panier.find(item => item.id === produit.id);
                if (existant) {
                    existant.quantite += 1;
                } else {
                    this.panier.push({ ...produit, quantite: 1 });
                }
                this.sauvegarderPanier();
                this.afficherPanier();
            }

            supprimerProduit(produitId) {
                this.panier = this.panier.filter(item => item.id !== produitId);
                this.sauvegarderPanier();
                this.afficherPanier();
            }

            modifierQuantite(produitId, nouvelleQuantite) {
                const produit = this.panier.find(item => item.id === produitId);
                if (produit && nouvelleQuantite > 0) {
                    produit.quantite = nouvelleQuantite;
                    this.sauvegarderPanier();
                    this.afficherPanier();
                } else if (nouvelleQuantite <= 0) {
                    this.supprimerProduit(produitId);
                }
            }

            viderPanier() {
                this.panier = [];
                this.sauvegarderPanier();
                this.afficherPanier();
            }

            obtenirTotal() {
                return this.panier.reduce((total, item) => total + (item.prix * item.quantite), 0);
            }

            obtenirNombreItems() {
                return this.panier.reduce((total, item) => total + item.quantite, 0);
            }

            mettreAJourCompteur() {
                const totalItems = this.obtenirNombreItems();
                
                // Mettre à jour le compteur local
                const compteurLocal = document.getElementById('compteur-panier');
                if (compteurLocal) {
                    compteurLocal.textContent = totalItems;
                }
                
                // Mettre à jour le compteur dans la navbar
                const compteurNavbar = document.getElementById('compteurPanier');
                if (compteurNavbar) {
                    compteurNavbar.textContent = totalItems;
                    compteurNavbar.style.display = totalItems > 0 ? 'inline-block' : 'none';
                }
                
                // Mettre à jour le localStorage pour compatibilité
                localStorage.setItem('panierCount', totalItems);
                
                // Animation du compteur
                if (totalItems > 0 && compteurNavbar) {
                    const lienPanier = document.getElementById('panierLink');
                    if (lienPanier) {
                        lienPanier.classList.add('text-warning');
                    }
                    compteurNavbar.classList.add('animate__animated', 'animate__pulse');
                    setTimeout(() => {
                        compteurNavbar.classList.remove('animate__animated', 'animate__pulse');
                    }, 600);
                }
            }

            afficherPanier() {
                const panierVide = document.getElementById('panier-vide');
                const listeProduits = document.getElementById('liste-produits');
                const resumeCommande = document.getElementById('resume-commande');

                if (this.panier.length === 0) {
                    panierVide.style.display = 'block';
                    listeProduits.style.display = 'none';
                    resumeCommande.style.display = 'none';
                } else {
                    panierVide.style.display = 'none';
                    listeProduits.style.display = 'block';
                    resumeCommande.style.display = 'block';
                    
                    this.afficherProduits();
                    this.mettreAJourResume();
                }
                
                this.mettreAJourCompteur();
            }

            afficherProduits() {
                const listeProduits = document.getElementById('liste-produits');
                const template = document.getElementById('template-produit-panier');
                
                if (!listeProduits || !template) return;
                
                listeProduits.innerHTML = '';
                
                this.panier.forEach(item => {
                    const clone = template.content.cloneNode(true);
                    
                    clone.querySelector('.produit-image').src = item.urlImage || '/images/default-product.jpg';
                    clone.querySelector('.produit-nom').textContent = item.nom;
                    clone.querySelector('.produit-marque').textContent = item.marque || '';
                    clone.querySelector('.produit-description').textContent = item.description || '';
                    clone.querySelector('.produit-prix').textContent = `${item.prix.toFixed(2)} €`;
                    clone.querySelector('.quantite-input').value = item.quantite;
                    
                    // Événements pour les boutons
                    const btnDiminuer = clone.querySelector('.btn-diminuer');
                    const btnAugmenter = clone.querySelector('.btn-augmenter');
                    const btnSupprimer = clone.querySelector('.btn-supprimer');
                    const inputQuantite = clone.querySelector('.quantite-input');
                    
                    btnDiminuer.addEventListener('click', () => {
                        this.modifierQuantite(item.id, item.quantite - 1);
                    });
                    
                    btnAugmenter.addEventListener('click', () => {
                        this.modifierQuantite(item.id, item.quantite + 1);
                    });
                    
                    btnSupprimer.addEventListener('click', () => {
                        if (confirm(`Êtes-vous sûr de vouloir supprimer "${item.nom}" du panier ?`)) {
                            this.supprimerProduit(item.id);
                        }
                    });
                    
                    inputQuantite.addEventListener('change', (e) => {
                        const nouvelleQuantite = parseInt(e.target.value);
                        if (nouvelleQuantite >= 0) {
                            this.modifierQuantite(item.id, nouvelleQuantite);
                        }
                    });
                    
                    listeProduits.appendChild(clone);
                });
            }

            mettreAJourResume() {
                const sousTotal = this.obtenirTotal();
                const fraisLivraison = sousTotal >= 50 ? 0 : 5.99;
                const total = sousTotal + fraisLivraison;
                
                document.getElementById('sous-total').textContent = `${sousTotal.toFixed(2)} €`;
                document.getElementById('frais-livraison').textContent = fraisLivraison === 0 ? 'Gratuite' : `${fraisLivraison.toFixed(2)} €`;
                document.getElementById('total').textContent = `${total.toFixed(2)} €`;
            }

            initialiserEvenements() {
                const btnViderPanier = document.getElementById('btn-vider-panier');
                const btnCommander = document.getElementById('btn-commander');
                
                if (btnViderPanier) {
                    btnViderPanier.addEventListener('click', () => {
                        if (confirm('Êtes-vous sûr de vouloir vider votre panier ?')) {
                            this.viderPanier();
                            this.showToast('Panier vidé avec succès !', 'info');
                        }
                    });
                }
                
                if (btnCommander) {
                    btnCommander.addEventListener('click', () => {
                        if (this.panier.length === 0) {
                            this.showToast('Votre panier est vide !', 'error');
                            return;
                        }
                        
                        // Rediriger vers la page de commande
                        window.location.href = '@Url.Action("Index", "Commande")';
                    });
                }
            }

            showToast(message, type = 'info') {
                const toastContainer = document.getElementById('toastContainer') || this.createToastContainer();
                const bgClass = type === 'success' ? 'success' : (type === 'error' ? 'danger' : 'primary');
                const iconClass = type === 'success' ? 'check-circle' : (type === 'error' ? 'exclamation-circle' : 'info-circle');

                const toastHtml = `
                    <div class="toast align-items-center text-white bg-${bgClass} border-0 mb-2" role="alert" aria-live="assertive" aria-atomic="true">
                        <div class="d-flex">
                            <div class="toast-body">
                                <i class="fas fa-${iconClass} me-2"></i>${message}
                            </div>
                            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Fermer"></button>
                        </div>
                    </div>
                `;
                
                toastContainer.insertAdjacentHTML('beforeend', toastHtml);
                const toastElement = toastContainer.lastElementChild;
                const bsToast = new bootstrap.Toast(toastElement, { delay: 3000 });
                bsToast.show();
                
                toastElement.addEventListener('hidden.bs.toast', () => {
                    toastElement.remove();
                });
            }

            createToastContainer() {
                const container = document.createElement('div');
                container.id = 'toastContainer';
                container.className = 'toast-container position-fixed top-0 end-0 p-3';
                container.style.zIndex = '9999';
                document.body.appendChild(container);
                return container;
            }
        }

        // Fonctions globales pour compatibilité avec l'ancien code
        function ajouterAuPanier(produit) {
            if (window.gestionnairePanier) {
                window.gestionnairePanier.ajouterProduit(produit);
                window.gestionnairePanier.showToast('Produit ajouté au panier !', 'success');
            }
        }

        function mettreAJourCompteurPanier() {
            if (window.gestionnairePanier) {
                window.gestionnairePanier.mettreAJourCompteur();
            }
        }

        // Initialiser le gestionnaire de panier
        document.addEventListener('DOMContentLoaded', function() {
            window.gestionnairePanier = new GestionnairedePanier();
        });

        // Écouter les changements de localStorage pour synchroniser entre onglets
        window.addEventListener('storage', (e) => {
            if (e.key === 'panier' && window.gestionnairePanier) {
                window.gestionnairePanier.chargerPanier();
                window.gestionnairePanier.afficherPanier();
            }
        });
    </script>
}